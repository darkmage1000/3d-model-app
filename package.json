{
  "name": "meshcraft-studio",
  "version": "1.3.0",
  "private": true,
  "description": "Create and rig original low-poly videogame creatures, humans, and props.",
  "author": "Meshcraft",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "build:standalone": "vite build --config vite.standalone.config.js && node scripts/package-standalone.mjs",
    "test:standalone": "node tests/standalone.mjs",
    "desktop": "npm run build:standalone && electron .",
    "build:windows": "npm run build:standalone && node scripts/build-windows.cjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.56.0",
    "vite": "^6.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
